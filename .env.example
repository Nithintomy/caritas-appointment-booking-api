# Application settings
NODE_ENV=development
PORT=3000

# SQL Server connection
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=CaritasAppointments

DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
DB_CONNECTION_TIMEOUT_MS=15000
DB_REQUEST_TIMEOUT_MS=15000
DB_POOL_MIN=0
DB_POOL_MAX=10

DB_SETUP_USER=caritas_setup
DB_SETUP_PASSWORD=REPLACE_WITH_SETUP_PASSWORD

DB_USER=caritas_app
DB_PASSWORD=REPLACE_WITH_STRONG_APPLICATION_PASSWORD

#Testing 
ALLOW_TEST_RESET=false
API_BASE_URL=http://localhost:3000
TEST_PATIENT_ID_START=9001
